{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:coverage)",
      "Bash(npx jest *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development.local)",
      "Read(./.env.test.local)",
      "Read(./.env.production.local)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(npm publish)",
      "Bash(npm publish *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/push-gate.sh",
            "if": "Bash(git push*)",
            "timeout": 600,
            "statusMessage": "Push gate: running lint:check + npm test + npm run test:e2e before allowing git push..."
          }
        ]
      }
    ]
  }
}
