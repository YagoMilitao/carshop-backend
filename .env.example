# Exemplo de variáveis para desenvolvimento local com valores fictícios.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
MONGO_URI=<DATABASE_URL>
# Credenciais de exemplo para autenticação administrativa.
ADMIN_EMAIL=admin.fake@example.com
ADMIN_PASSWORD=fake-password-123

# Configuração fake dos tokens JWT.
JWT_SECRET=<JWT_SECRET>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

# Documentação OpenAPI/Swagger:
# - em production, fica desabilitada por padrão;
# - defina true para habilitar manualmente.
ENABLE_SWAGGER=true

#Cloudinary config (para upload de imagens):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=

# Obsidian (base de conhecimento técnico, usada pelo agente knowledge-manager):
OBSIDIAN_VAULT_ID=SEU_VAULT_ID