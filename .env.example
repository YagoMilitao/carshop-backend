# Exemplo de variáveis para desenvolvimento local com valores fictícios.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
MONGO_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/carshop?retryWrites=true&w=majority&appName=Cluster0
# Credenciais de exemplo para autenticação administrativa.
ADMIN_EMAIL=admin.fake@example.com
ADMIN_PASSWORD=fake-password-123

# Configuração fake dos tokens JWT.
JWT_SECRET=fake-jwt-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

# Documentação OpenAPI/Swagger:
# - em production, fica desabilitada por padrão;
# - defina true para habilitar manualmente.
ENABLE_SWAGGER=true
