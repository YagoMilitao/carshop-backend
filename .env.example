# Exemplo de variáveis para desenvolvimento local com valores fictícios.
NODE_ENV=development
PORT=3000
# Em produção (NODE_ENV=production), CORS_ORIGIN é obrigatória e cada
# origem precisa ser uma URL https:// absoluta e explícita (sem curinga
# "*", sem hostname isolado, sem http://).
CORS_ORIGIN=http://localhost:3001
MONGO_URI=<DATABASE_URL>
# Credenciais de exemplo para autenticação administrativa.
# Em produção (NODE_ENV=production), ADMIN_PASSWORD precisa ter no mínimo
# 12 caracteres, incluindo letra maiúscula, letra minúscula, dígito e
# símbolo, e não pode ser um valor fraco/padrão conhecido (ex.: "123456",
# "password", "admin", "changeme"). Fora de produção, essa política não
# bloqueia o startup.
ADMIN_EMAIL=admin.fake@example.com
ADMIN_PASSWORD=fake-password-123

# Configuração fake dos tokens JWT.
# Em produção (NODE_ENV=production), JWT_SECRET precisa ter no mínimo 32
# caracteres. Fora de produção, esse requisito não bloqueia o startup.
JWT_SECRET=<JWT_SECRET>
# JWT_EXPIRES_IN e JWT_REFRESH_EXPIRES_IN precisam ser durações válidas
# (inteiro em segundos, ou "<número><unidade>" com unidade ms|s|m|h|d) e
# são limitadas por um teto de duração em todos os ambientes:
# JWT_EXPIRES_IN <= 1h e JWT_REFRESH_EXPIRES_IN <= 30d.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

# Documentação OpenAPI/Swagger:
# - em production, fica desabilitada por padrão;
# - defina true para habilitar manualmente.
ENABLE_SWAGGER=true

#Cloudinary config (para upload de imagens):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=

# Obsidian (base de conhecimento técnico, usada pelo agente knowledge-manager):
OBSIDIAN_VAULT_ID=SEU_VAULT_ID

# Rotina de expurgo definitivo de works removidos logicamente (em dias).
WORK_HARD_DELETE_AFTER_DAYS=90

# Número de "hops" de proxy reverso confiáveis à frente da aplicação,
# usado para configurar o `trust proxy` do Express (resolução segura do
# IP do cliente para rate limiting). O padrão 0 não confia em proxies;
# configure um valor maior apenas conforme a topologia validada do deploy.
TRUST_PROXY_HOPS=0
